{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "backend/.venv/bin/uvicorn",
      "runtimeArgs": ["app.main:app", "--reload", "--port", "8000", "--app-dir", "backend"],
      "port": 8000
    },
    {
      "name": "frontend",
      "runtimeExecutable": "backend/.venv/bin/streamlit",
      "runtimeArgs": ["run", "frontend/App.py", "--server.port", "8501", "--server.headless", "true"],
      "port": 8501
    }
  ]
}
