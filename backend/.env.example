# Copy this file to .env and fill in your real values.
# APP_ENV=development uses local JSON-file storage -- no AWS credentials needed.
# APP_ENV=production  uses real DynamoDB + S3 -- fill in AWS keys below.

ANTHROPIC_API_KEY=
GROQ_API_KEY=

AWS_REGION=eu-west-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=medreport-ai-bucket
DYNAMODB_TABLE_NAME=medreport-reports

APP_ENV=development
